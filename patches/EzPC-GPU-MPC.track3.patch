+
+// For callers that need a WRITABLE device copy of key material (they write to
+// the buffer, e.g. gpuSelect's d_a, gpuMatmulBeaver's d_C / d_r1). With the
+// key arena active, a plain moveToGPU would hand them the read-only master
+// copy and corrupt the keys — so clone D2D into a fresh pool buffer instead.
+extern "C" uint8_t *moveToGPUWritable(uint8_t *h_a, size_t size_in_bytes, Stats *s)
+{
+    if (arenaOwnsHostPtr(h_a))
+    {
+        uint8_t *d_a = gpuMalloc(size_in_bytes);
+        checkCudaErrors(cudaMemcpyAsync(d_a,
+                                        g_keyArenaDev + ((uintptr_t)h_a - (uintptr_t)g_keyArenaHost),
+                                        size_in_bytes, cudaMemcpyDeviceToDevice, 0));
