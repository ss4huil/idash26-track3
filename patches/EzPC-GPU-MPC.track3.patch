@@ -131,3 +227,20 @@ extern "C" uint8_t *moveToGPU(uint8_t *h_a, size_t size_in_bytes, Stats *s)
         s->transfer_time += std::chrono::duration_cast<std::chrono::microseconds>(elapsed).count();
     return d_a;
