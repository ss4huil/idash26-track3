+// ── GPU-resident key arena ──────────────────────────────────────────────────
+// The party's whole FSS key file is bulk-uploaded to the GPU once at online
+// start. Afterwards, moveToGPU() on any host pointer inside the key buffer
+// returns the device mirror with NO copy, and gpuFree() on arena pointers is
+// a no-op. This eliminates the per-op malloc+H2D+free cycle for key material.
+// Env: DDG_KEY_ARENA=0 disables; DDG_KEY_ARENA_PCT (default 40) caps the
+// arena to that % of free VRAM (two parties share one GPU); if the keys do
+// not fit, the arena stays inactive and the old per-op path is used.
+static uint8_t *g_keyArenaHost = nullptr;
+static uint8_t *g_keyArenaDev = nullptr;
+static size_t g_keyArenaSize = 0;
+
+static inline bool arenaOwnsHostPtr(const void *h)
+{
+    return g_keyArenaDev && h &&
+           (uintptr_t)h - (uintptr_t)g_keyArenaHost < g_keyArenaSize;
+}
+
+static inline bool arenaOwnsDevPtr(const void *d)
+{
+    return g_keyArenaDev && d &&
+           (uintptr_t)d - (uintptr_t)g_keyArenaDev < g_keyArenaSize;
+}
+
+extern "C" bool initGPUKeyArena(uint8_t *h_base, size_t size)
+{
+    const char *dis = getenv("DDG_KEY_ARENA");
+    if (dis && dis[0] == '0')
+    {
+        printf("[keyArena] disabled via DDG_KEY_ARENA=0\n");
+        return false;
+    }
+    const char *pctEnv = getenv("DDG_KEY_ARENA_PCT");
+    int pct = pctEnv ? atoi(pctEnv) : 40;
+    size_t freeB = 0, totalB = 0;
+    checkCudaErrors(cudaMemGetInfo(&freeB, &totalB));
+    if (size > freeB * (size_t)pct / 100)
+    {
+        printf("[keyArena] keys %.1f GB exceed %d%% of free VRAM %.1f GB — per-op key upload fallback\n",
+               size / 1e9, pct, freeB / 1e9);
+        return false;
+    }
+    uint8_t *d = nullptr;
+    checkCudaErrors(cudaMalloc(&d, size));
+    auto start = std::chrono::high_resolution_clock::now();
+    checkCudaErrors(cudaMemcpy(d, h_base, size, cudaMemcpyHostToDevice));
+    auto end = std::chrono::high_resolution_clock::now();
+    g_keyArenaHost = h_base;
+    g_keyArenaDev = d;
+    g_keyArenaSize = size;
+    printf("[keyArena] uploaded %.2f GB keys to GPU in %ld ms\n", size / 1e9,
+           std::chrono::duration_cast<std::chrono::milliseconds>(end - start).count());
+    return true;
+}
+
+extern "C" void freeGPUKeyArena()
+{
+    if (g_keyArenaDev)
+    {
+        cudaFree(g_keyArenaDev);
+        g_keyArenaDev = nullptr;
+        g_keyArenaHost = nullptr;
+        g_keyArenaSize = 0;
+    }
+}
+
+// Slot mode for chunked streaming eval (DDG_NUM_CHUNKS > 1): the caller owns
+// double-buffered pinned host slots + VRAM slots (one chunk of the key file
+// each) and repoints the arena mapping at the active chunk's slot before each
+// forward. No allocation, no copy, no free — the caller manages the buffers
+// and the VRAM budget (2 slots x chunkKeySize). moveToGPU / gpuFree translate
+// against whatever slot is currently bound, exactly like the whole-file arena.
+extern "C" void setGPUKeyArenaSlot(uint8_t *h_base, uint8_t *d_base, size_t size)
+{
+    g_keyArenaHost = h_base;
+    g_keyArenaDev = d_base;
+    g_keyArenaSize = size;
+}
